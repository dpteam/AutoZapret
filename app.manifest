<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="AutoZapret.app" />

  <!--
    asInvoker: приложение НЕ требует прав администратора целиком.
    Повышение запрашивается точечно (runas) только для операций со службами
    и драйвером WinDivert - см. AGENTS.md, "Работа с процессами и драйвером".

    ВАЖНО: параметры DPI здесь НЕ задаются. Начиная с .NET 6 WinForms требует
    настраивать их через Application.SetHighDpiMode (см. Program.cs) или
    свойство проекта ApplicationHighDpiMode. Иначе сборка выдаёт WFO0003,
    а режим может не примениться.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11. Более старые ОС не поддерживаются: .NET 9 требует 10 1607+ -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
