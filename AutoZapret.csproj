<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoZapret - .NET 9 / x64 / WinForms-хост + WebView2 UI.

    Правила (см. AGENTS.md):
      * единственная внешняя зависимость - WebView2 SDK из lib\webview2,
        качается tools\fetch-webview2.ps1;
      * UI живёт в web\ и вшивается ресурсами (LogicalName задан явно);
      * сборка - build.cmd (для разработки), публикация - publish.cmd
        (self-contained single-file, .NET у пользователя не нужен).

    Windows 7/8.1 больше не поддерживаются: .NET 9 требует Windows 10 1607+.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>AutoZapret</AssemblyName>
    <RootNamespace>AutoZapret</RootNamespace>
    <!-- WinForms нужен только ради хоста окна и NotifyIcon; UI - WebView2 -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- x64 обязателен: 32-битного winws.exe не существует -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- источники и ресурсы подключаем вручную, чтобы ничто не подхватилось само -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <ApplicationIcon>assets\AutoZapret.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <Product>AutoZapret</Product>
    <Company>DPT</Company>
    <Copyright>MIT. Обёртка над zapret (bol-van), конфиги Flowseal.</Copyright>

    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      DPI: настраивается здесь, а не в манифесте. С .NET 6 WinForms требует
      именно этого пути (иначе WFO0003 и возможное игнорирование режима).
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!--
      CS1591: нет XML-комментариев
      SYSLIB0014: HttpWebRequest/WebClient помечены устаревшими, но работают
                  и уже покрыты тестами; переход на HttpClient - отдельная задача
      CA1416: платформенные предупреждения - мы и так только Windows
    -->
    <NoWarn>$(NoWarn);CS1591;SYSLIB0014;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Единственная сторонняя зависимость. Скачивается tools\fetch-webview2.ps1 -->
  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>lib\webview2\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>lib\webview2\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="lib\webview2\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!--
        CopyToPublishDirectory обязателен отдельно: при single-file publish
        копирование в output не переносится автоматически, и без этой строки
        WebView2Loader.dll не попадает в дистрибутив - окно не запускается.
      -->
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- UI: вшивается в exe, наружу ничего не распаковывается -->
  <ItemGroup>
    <EmbeddedResource Include="web\ui.html">
      <LogicalName>AutoZapret.Web.ui.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\app.js">
      <LogicalName>AutoZapret.Web.app.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\theme.css">
      <LogicalName>AutoZapret.Web.theme.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\i18n\en.json">
      <LogicalName>AutoZapret.Web.i18n.en.json</LogicalName>
    </EmbeddedResource>
    <!--
      Код внешнего релея. Лежит в exe, а не в папке: кнопка «Как сделать свой?»
      должна работать без интернета и без распакованных файлов рядом.
    -->
    <EmbeddedResource Include="web\relay\worker.js">
      <LogicalName>AutoZapret.Web.relay.worker.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      Данные продукта: стратегии, фейки, списки, hosts, пресеты.

      Копируются самим MSBuild, а не скриптом сборки. Раньше это делал только
      build.cmd, и любой другой способ сборки (dotnet build, как в GitHub
      Actions) давал exe БЕЗ данных: приложение стартовало с нулём стратегий,
      и selftest падал на «v1 найдены -> 0 шт.» — при том что файлы лежали
      в репозитории.

      Ошибка была в том, что «собирается» и «работает» — разные вещи, а
      зависимость от скрипта делала вторую необязательной.
    -->
    <Content Include="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
