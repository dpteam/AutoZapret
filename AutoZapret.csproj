<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoZapret - .NET Framework 4.8 / x64 / WinForms-хост + WebView2 UI.

    Правила (см. AGENTS.md):
      * никакого NuGet: единственная внешняя ссылка - WebView2 SDK из lib\webview2,
        качается tools\fetch-webview2.ps1;
      * UI живёт в web\ и вшивается ресурсами (LogicalName задан явно);
      * сборка - build.cmd (обёртка над dotnet build).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutoZapret</AssemblyName>
    <RootNamespace>AutoZapret</RootNamespace>

    <!-- x64 обязателен: 32-битного winws.exe не существует -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- источники и ресурсы подключаем вручную, чтобы ничто не подхватилось само -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <ApplicationIcon>assets\AutoZapret.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Product>AutoZapret</Product>
    <Company>DPT</Company>
    <Copyright>MIT. Обёртка над zapret (bol-van), конфиги Flowseal.</Copyright>

    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- CS1591: нет XML-комментариев; CS0618: устаревшие API BCL осознанно -->
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Единственная сторонняя зависимость. Скачивается tools\fetch-webview2.ps1 -->
  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>lib\webview2\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>lib\webview2\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="lib\webview2\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- UI: вшивается в exe, наружу ничего не распаковывается -->
  <ItemGroup>
    <EmbeddedResource Include="web\ui.html">
      <LogicalName>AutoZapret.Web.ui.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\app.js">
      <LogicalName>AutoZapret.Web.app.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\theme.css">
      <LogicalName>AutoZapret.Web.theme.css</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\AutoZapret.ico" />
  </ItemGroup>

</Project>
