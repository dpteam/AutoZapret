<?xml version="1.0" encoding="utf-8"?>
<!--
  Логотип AutoZapret.

  Знак: стрелка проходит сквозь разбитую стену.

  Почему так, а не замок. Первый вариант (разорванный замок с зигзагом) в
  мелком размере превращался в мутное пятно: три формы, зубчатый край, тонкие
  линии. В трее телефона это читается как «что-то сломалось», а не как логотип.

  Здесь три простые фигуры и один смысл: препятствие есть, трафик его проходит.
  Силуэт узнаётся на 24 px, потому что всё построено на крупных пятнах, без
  обводок и мелочей.

  Геометрия (viewport 108, безопасная зона 18..90):
    * стена — два обломка со скошенными краями, разрыв по центру;
    * стрелка — древко + наконечник, идёт точно через разрыв.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Верхний обломок стены: нижняя грань скошена, как у скола -->
    <path
        android:pathData="M41,26 L50,26 L50,41 L41,46 Z"
        android:fillColor="#4A5878" />

    <!-- Нижний обломок: верхняя грань скошена в другую сторону -->
    <path
        android:pathData="M41,62 L50,57 L50,82 L41,82 Z"
        android:fillColor="#4A5878" />

    <!-- Древко стрелки -->
    <path
        android:pathData="M19,49 L67,49 L67,59 L19,59 Z"
        android:fillColor="#F0B429" />

    <!-- Наконечник -->
    <path
        android:pathData="M65,39 L91,54 L65,69 Z"
        android:fillColor="#F0B429" />
</vector>
