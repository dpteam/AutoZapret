<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <!--
      hev-socks5-tunnel собран под android-29 (APP_PLATFORM в его Application.mk).
      Поэтому и приложение не может обещать меньше: на API 28 библиотека просто
      не загрузится.
    -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>

    <!-- Стиль как в десктопном проекте: без NRT, без неявных using -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <ApplicationId>ru.autozapret.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>

    <AssemblyName>AutoZapret.Android</AssemblyName>
    <RootNamespace>AutoZapret.Android</RootNamespace>

    <!--
      Fast Deployment ВЫКЛЮЧЕН осознанно.
      В Debug .NET Android по умолчанию собирает APK-«оболочку», а сборки
      доливает в /data/.../.__override__ при установке через IDE. Такой APK,
      поставленный обычным `adb install`, падает на старте:
        "No assemblies found in .../.__override__ ... Exiting"
      Нам нужен файл, который ставится на любой телефон без IDE, поэтому
      сборки лежат внутри APK.
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!--
      Trimming выключен: у нас мало кода, а обрезатель любит выкидывать то,
      что вызывается только из Java (JS-интерфейс) или через рефлексию.
    -->
    <TrimMode>partial</TrimMode>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Экран приложения: одна страница, без внешних зависимостей -->
    <AndroidAsset Include="Assets\mobile.html">
      <Link>Assets/mobile.html</Link>
    </AndroidAsset>

    <!--
      Наборы стратегий — те же файлы, что у десктопа, подключены ссылкой, а не
      копией. Один источник правды: правка стратегии на десктопе сразу видна
      Android-версии, и расхождение «на десктопе ALT7, на телефоне ALT6»
      невозможно по построению.
    -->
    <AndroidAsset Include="..\..\assets\strategies\strategies.v1.json">
      <Link>strategies.v1.json</Link>
    </AndroidAsset>
    <AndroidAsset Include="..\..\assets\strategies\strategies.v2.json">
      <Link>strategies.v2.json</Link>
    </AndroidAsset>
  </ItemGroup>

  <!--
    tun2socks (MIT) лежит в libs\<abi>\libhev-socks5-tunnel.so и попадает в APK
    автоматическим правилом для нативных библиотек. Отдельный AndroidNativeLibrary
    добавлять не нужно: получится дубликат (XA4301) и файл просто пропустят.
    Собирается android\build-hev.cmd.
  -->
</Project>